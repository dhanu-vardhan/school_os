# SchoolOS environment template. Copy to `.env` for local use; never commit real secrets.
# The demo profile is an explicit, local-only mode. Production refuses it.

# Environment name: local | staging | production
SCHOOLOS_ENV=local

# BFF profile: local | demo | test. `demo` additionally requires DEMO_MODE=true.
SCHOOLOS_PROFILE=demo
DEMO_MODE=true

# Public origins allowed to call the BFF (comma separated).
ALLOWED_ORIGINS=http://localhost:3000

# Cookies: local HTTP may use false. Production must be true (HTTPS).
COOKIE_SECURE=false

# Long random values (>= 32 chars) in any shared environment.
SESSION_SECRET=schoolos-local-session-secret-change-me
SCHOOLOS_DEMO_JWT_SECRET=schoolos-local-demo-jwt-secret-change-me

# BFF -> API and API -> Postgres/Keycloak.
API_BASE_URL=http://localhost:8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/schoolos
SCHOOLOS_ISSUER_URI=http://localhost:8081/realms/schoolos

# OIDC (production path; demo does not need Keycloak).
OIDC_ISSUER=http://localhost:8081/realms/schoolos
OIDC_CLIENT_ID=schoolos-bff
OIDC_CLIENT_SECRET=schoolos-bff-secret
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_API_AUDIENCE=schoolos-api
OIDC_SCOPES=openid profile email organization

# Session store: unset -> in-memory (single process, dev only). Set for multi-instance.
# REDIS_URL=redis://localhost:6379

# Generated demo credentials (mode 0600, git-ignored). Defaults to <repo>/.demo/credentials.json.
# DEMO_CREDENTIALS_FILE=/absolute/path/.demo/credentials.json

# Token/session tuning (seconds).
JWT_TTL_SECONDS=300
SESSION_TTL_SECONDS=43200
IDLE_TIMEOUT_SECONDS=1800
PRIVILEGED_IDLE_TIMEOUT_SECONDS=900
STEP_UP_SECONDS=600
TRUST_DEVICE_DAYS=30
