{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@schoolos/ui": ["../../packages/ui/src/index.ts"],
      "@schoolos/ui/*": ["../../packages/ui/src/*"],
      "@schoolos/shared": ["../../packages/shared/src/index.ts"],
      "@schoolos/i18n": ["../../packages/i18n/src/index.ts"],
      "@schoolos/api-client": ["../../packages/api-client/src/index.ts"],
      "@/*": ["src/*"]
    },
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src"]
}
